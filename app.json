{
  "expo": {
    "name": "Selah",
    "slug": "selah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "selah",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.selah.journal",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Selah uses Face ID to unlock your private journal.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.selah.journal"
        ]
      }
    },
    "android": {
      "package": "app.selah.journal",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3FA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#1D1B26"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Selah uses Face ID to unlock your private journal."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "reflection"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selah lets you attach photos from your library to journal entries."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Selah can note where you were when you wrote only if you tap the location button."
        }
      ],
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Selah",
              "label": "Selah",
              "description": "A verse, a note, or your rhythm, kept in view.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/icon.png"
            }
          ]
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "Y2DS94HLY8"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "bibleBaseUrl": "",
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "app.selah.journal.widget",
                  "targetName": "SelahWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.selah.journal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "1d8755a1-a704-4724-92db-82729c5960c5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1d8755a1-a704-4724-92db-82729c5960c5"
    }
  }
}
